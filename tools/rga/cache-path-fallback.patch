+        }
+        if let Ok(project) = project_dirs() {
+            if let Some(text) = project.cache_dir().to_str() {
+                return Self(text.to_owned());
+            }
+        }
+        Self(std::env::temp_dir().join("ripgrep-all-cache").to_string_lossy().into_owned())
     }
 }
 
