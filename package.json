{
  "name": "@s1lencewill/dsh-knowledge",
  "version": "0.1.0-alpha.9",
  "description": "DSH knowledge-base plugin backed by a managed Sirchmunk service",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "engine/*.py",
    "engine/*.lock",
    "ui/source-card.js",
    "trial/*.mjs",
    "trial/*.cs",
    "tools/rga/*.patch",
    "tools/rga/*.md",
    "samples",
    "docs/QUICKSTART.md",
    "docs/LIMITATIONS.md",
    "docs/VERSION-AND-DEPENDENCIES.md",
    "docs/RUNTIME-BUILD.md",
    "cordis.patch.yml",
    "LICENSE-DRAFT.md",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "VERSION",
    "RELEASE-MANIFEST.json",
    "docs/PRIVATE-BETA.md",
    "tools/rga/SOURCE.json",
    "docs/PRIVACY.md",
    "docs/ALPHA-READINESS.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "docs/RELEASE-VALIDATION.md",
    "docs/BUILD-CONSISTENCY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke:dsh": "node scripts/smoke-dsh.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:ref-chain": "node scripts/probe-ref-chain.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "trial:install": "node trial/install.mjs",
    "trial:doctor": "node trial/doctor.mjs",
    "trial:start": "node trial/start.mjs",
    "trial:stop": "node trial/stop.mjs",
    "release:pack": "node scripts/package-release.mjs pack",
    "release:audit": "node scripts/package-release.mjs audit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "private": true,
  "keywords": [
    "dsh-plugin",
    "knowledge-base",
    "sirchmunk",
    "pdf",
    "markdown"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/s1lencewill/dsh-knowledge-public.git"
  },
  "homepage": "https://github.com/s1lencewill/dsh-knowledge-public#readme",
  "bugs": {
    "url": "https://github.com/s1lencewill/dsh-knowledge-public/issues"
  }
}
